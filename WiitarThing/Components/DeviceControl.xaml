<UserControl x:Class="WiinUSoft.DeviceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="300">

    <!-- Device row for WinUI-style list surfaces -->
    <Border BorderThickness="0"
            Padding="10"
            Background="Transparent"
            x:Name="statusGradient">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Device icon with type-override flyout (right-click) -->
            <Image x:Name="icon"
                   Grid.Column="0"
                   Source="{StaticResource UIcon}"
                   Width="40"
                    Height="40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RightTapped="icon_RightTapped">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="typeClear"
                                Text="Reset"
                                Click="typeOption_Click"/>
                        <MenuFlyoutItem x:Name="typePro"
                                Text="Pro Controller"
                                Click="typeOption_Click"/>
                        <MenuFlyoutItem x:Name="typeWiimote"
                                Text="Wiimote"
                                Click="typeOption_Click"/>
                        <MenuFlyoutItem x:Name="typeNunchuk"
                                Text="Nunchuk"
                                Click="typeOption_Click"/>
                        <MenuFlyoutItem x:Name="typeClassic"
                                Text="Classic Controller"
                                Click="typeOption_Click"/>
                        <MenuFlyoutItem x:Name="typeClassicPro"
                                Text="Classic Controller Pro"
                                Click="typeOption_Click"/>
                        <MenuFlyoutItem x:Name="typeGuitar"
                                Text="Wii Guitar"
                                Click="typeOption_Click"/>
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
            </Image>

            <!-- Device name + unavailable label -->
            <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="labelName"
                               Grid.Column="0"
                               FontWeight="SemiBold"
                               Text="Unknown Device"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="nameInput"
                             Grid.Column="0"
                             Height="32"
                             Visibility="Collapsed"
                             TextChanged="nameInput_TextChanged"
                             KeyDown="nameInput_KeyDown"
                             LostFocus="nameInput_LostFocus"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="btnEditName"
                            Grid.Column="1"
                            Width="38"
                            Height="34"
                            MinWidth="0"
                            MinHeight="0"
                            Margin="8,0,4,0"
                            Padding="8,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTipService.ToolTip="Edit name"
                            Click="btnEditName_Click"
                            AutomationProperties.Name="Edit name">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE70F;"
                                  FontSize="13"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="labelUnavailable"
                           Text="Device Unavailable"
                           Visibility="Collapsed"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="4">

                <!-- Guitar input preview (active guitar controllers only) -->
                <StackPanel x:Name="guitarPreview"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Visibility="Collapsed"
                            Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <Border x:Name="fretG"
                                Width="7"
                                Height="24"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="#FF2DA44E"/>
                        <Border x:Name="fretR"
                                Width="7"
                                Height="24"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="#FFD13438"/>
                        <Border x:Name="fretY"
                                Width="7"
                                Height="24"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="#FFFFC83D"/>
                        <Border x:Name="fretB"
                                Width="7"
                                Height="24"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="#FF0078D4"/>
                        <Border x:Name="fretO"
                                Width="7"
                                Height="24"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="#FFFF8C00"/>
                    </StackPanel>

                    <Border Width="24"
                            Height="24"
                            BorderThickness="1"
                            CornerRadius="12"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}">
                        <TextBlock x:Name="strumIndicator"
                                   Text="."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-3,0,0"/>
                    </Border>

                    <Grid Width="58"
                          Height="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="previewWH"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Text="WH"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="previewWL"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Text="WL"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="previewTH"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Text="TH"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="previewTL"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Text="TL"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="previewStart"
                                   Grid.Row="0"
                                   Grid.Column="2"
                                   Text="St"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="previewSelect"
                                   Grid.Row="1"
                                   Grid.Column="2"
                                   Text="Sl"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Debug view (debug builds only) -->
                <Button x:Name="btnDebugView"
                        Width="34"
                        Height="34"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTipService.ToolTip="Debug View"
                        Click="btnDebugView_Click"
                        AutomationProperties.Name="Debug View">
                    <Image Source="../Images/Properties-icon.png"
                            Width="16"
                            Height="16"
                            Stretch="Uniform"/>
                </Button>

                <!-- Identify -->
                <Button x:Name="btnIdentify"
                        Width="34"
                        Height="34"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTipService.ToolTip="Identify (rumble)"
                        Click="btnIdentify_Click"
                        AutomationProperties.Name="Identify">
                    <Image Source="../Images/IDicon3.png"
                            Width="16"
                            Height="16"
                            Stretch="Uniform"/>
                </Button>

                <!-- Auto-connect target -->
                <ComboBox x:Name="autoConnectNumber"
                          Width="148"
                          Height="34"
                          SelectedIndex="0"
                          SelectionChanged="AutoConnect_SelectionChanged"
                          ToolTipService.ToolTip="Auto-connect target"
                          AutomationProperties.Name="Auto-connect target">
                    <ComboBoxItem Content="Auto: Off"/>
                    <ComboBoxItem Content="Auto: Player 1"/>
                    <ComboBoxItem Content="Auto: Player 2"/>
                    <ComboBoxItem Content="Auto: Player 3"/>
                    <ComboBoxItem Content="Auto: Player 4"/>
                    <ComboBoxItem Content="Auto: First"/>
                </ComboBox>

                <!-- Connect (with player-selection flyout) -->
                <Button x:Name="btnXinput"
                        Height="34"
                        MinHeight="0"
                        Padding="12,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="CONNECT"
                        ToolTipService.ToolTip="Connect as an Xbox 360 controller"
                        IsEnabledChanged="btnXinput_IsEnabledChanged">
                    <Button.Flyout>
                        <MenuFlyout Opening="XInputFlyout_Opening">
                            <MenuFlyoutItem x:Name="XOption1"
                                    Text="Player 1"
                                    Click="XOption_Click"/>
                            <MenuFlyoutItem x:Name="XOption2"
                                    Text="Player 2"
                                    Click="XOption_Click"/>
                            <MenuFlyoutItem x:Name="XOption3"
                                    Text="Player 3"
                                    Click="XOption_Click"/>
                            <MenuFlyoutItem x:Name="XOption4"
                                    Text="Player 4"
                                    Click="XOption_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Disconnect -->
                <Button x:Name="btnDetatch"
                        Height="34"
                        MinHeight="0"
                        Padding="12,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="DISCONNECT"
                        ToolTipService.ToolTip="Disconnect this controller"
                        Click="btnDetatch_Click"
                        Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
