<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Semantic color tokens ─────────────────────────────────────────── -->

    <!-- Surface colors -->
    <Color x:Key="Color.Window">#FFF5F5F5</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFF0F4F8</Color>
    <Color x:Key="Color.Border">#FFCCCCCC</Color>
    <Color x:Key="Color.BorderAccent">#FF0078D4</Color>

    <!-- Text colors -->
    <Color x:Key="Color.Text.Primary">#FF1A1A1A</Color>
    <Color x:Key="Color.Text.Secondary">#FF5F5F5F</Color>
    <Color x:Key="Color.Text.Disabled">#FFAAAAAA</Color>

    <!-- Accent -->
    <Color x:Key="Color.Accent">#FF0078D4</Color>
    <Color x:Key="Color.AccentHover">#FF106EBE</Color>
    <Color x:Key="Color.AccentPressed">#FF005A9E</Color>
    <Color x:Key="Color.AccentLight">#FFDCE9F5</Color>

    <!-- Status / warning -->
    <Color x:Key="Color.Warning">#FFDF6C25</Color>
    <Color x:Key="Color.WarningLight">#FFFFF4E5</Color>
    <Color x:Key="Color.Danger">#FFCC0000</Color>
    <Color x:Key="Color.DangerLight">#FFFFF0F0</Color>
    <Color x:Key="Color.Success">#FF107C10</Color>

    <!-- Device row -->
    <Color x:Key="Color.DeviceRow">#FFFAFAFA</Color>
    <Color x:Key="Color.DeviceRowConnected">#FFF0F8FF</Color>
    <Color x:Key="Color.DeviceRowLowBattery">#FFDF6C25</Color>

    <!-- Legacy bridge – keeps existing XAML that references these keys working -->
    <Color x:Key="AntemWhite">#FFF5F5F5</Color>
    <Color x:Key="SocialBlue">#FFF0F4F8</Color>
    <Color x:Key="Eyeing">#FFF0F4F8</Color>
    <Color x:Key="AntemSky">#FFBCD5EA</Color>
    <Color x:Key="AntemBlue">#FF0078D4</Color>
    <Color x:Key="JohnTheRevelater">#FFCCCCCC</Color>
    <Color x:Key="LowBattery">#FFDF6C25</Color>

    <!-- ── Brushes ────────────────────────────────────────────────────────── -->

    <SolidColorBrush x:Key="Brush.Window"         Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.Surface"        Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt"     Color="{StaticResource Color.SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush.Border"         Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderAccent"   Color="{StaticResource Color.BorderAccent}"/>

    <SolidColorBrush x:Key="Brush.Text.Primary"   Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled"  Color="{StaticResource Color.Text.Disabled}"/>

    <SolidColorBrush x:Key="Brush.Accent"         Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover"    Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentLight"    Color="{StaticResource Color.AccentLight}"/>

    <SolidColorBrush x:Key="Brush.Warning"        Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.WarningLight"   Color="{StaticResource Color.WarningLight}"/>
    <SolidColorBrush x:Key="Brush.Danger"         Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerLight"    Color="{StaticResource Color.DangerLight}"/>

    <SolidColorBrush x:Key="Brush.DeviceRow"          Color="{StaticResource Color.DeviceRow}"/>
    <SolidColorBrush x:Key="Brush.DeviceRowConnected" Color="{StaticResource Color.DeviceRowConnected}"/>

    <!-- Legacy bridge brushes -->
    <SolidColorBrush x:Key="BrushAntemWhite"          Color="{StaticResource AntemWhite}"/>
    <SolidColorBrush x:Key="BrushSocialBlue"          Color="{StaticResource SocialBlue}"/>
    <SolidColorBrush x:Key="BrushEyeing"              Color="{StaticResource Eyeing}"/>
    <SolidColorBrush x:Key="BrushAntemSky"            Color="{StaticResource AntemSky}"/>
    <SolidColorBrush x:Key="BrushAntemBlue"           Color="{StaticResource AntemBlue}"/>
    <SolidColorBrush x:Key="BrushJohnTheRevelator"    Color="{StaticResource JohnTheRevelater}"/>

    <!-- Legacy gradient button brush – kept for compatibility -->
    <SolidColorBrush x:Key="ButonFillBrush1"          Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="ButonFillBrush1_Red"      Color="{StaticResource Color.DangerLight}"/>

</ResourceDictionary>
