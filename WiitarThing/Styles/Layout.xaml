<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing constants -->

    <Thickness x:Key="Margin.None">0</Thickness>
    <Thickness x:Key="Margin.XSmall">4</Thickness>
    <Thickness x:Key="Margin.Small">8</Thickness>
    <Thickness x:Key="Margin.Medium">12</Thickness>
    <Thickness x:Key="Margin.Large">16</Thickness>
    <Thickness x:Key="Margin.XLarge">24</Thickness>

    <Thickness x:Key="Padding.Button">10,5</Thickness>
    <Thickness x:Key="Padding.IconButton">4</Thickness>
    <Thickness x:Key="Padding.Input">6,4</Thickness>

    <CornerRadius x:Key="CornerRadius.Control">4</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Card">6</CornerRadius>

    <x:Double x:Key="FontSize.Small">11</x:Double>
    <x:Double x:Key="FontSize.Normal">13</x:Double>
    <x:Double x:Key="FontSize.Large">15</x:Double>
    <x:Double x:Key="FontSize.SectionHeader">14</x:Double>

</ResourceDictionary>
