<Window x:Class="WiinUSoft.Windows.DebugDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug - Wiimote Data">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Wiimote data packets are displayed below."
                   FontSize="13"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1"
                Style="{StaticResource SectionPanelStyle}"
                Margin="0,0,0,8">
            <TextBox x:Name="promptBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     FontSize="13"
                     FontFamily="Courier New"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </Border>

        <Button Grid.Row="2"
                x:Name="cancelBtn"
                Style="{StaticResource BaseButtonStyle}"
                Content="Close"
                Width="80"
                Height="28"
                HorizontalAlignment="Right"
                Click="cancelBtn_Click"/>
    </Grid>
</Window>
