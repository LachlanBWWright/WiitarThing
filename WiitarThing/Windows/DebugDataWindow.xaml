<ContentDialog x:Class="WiinUSoft.Windows.DebugDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug - Wiimote Data">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="6"
                Margin="0,0,0,12">
            <TextBlock Text="Wiimote Data Monitor"/>
            <TextBlock
                       Text="Raw Wiimote data packets are displayed below for debugging."/>
        </StackPanel>

        <TextBox Grid.Row="1"
                 x:Name="promptBox"
                 Margin="0,0,0,12"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="11"/>

        <Button Grid.Row="2"
                x:Name="cancelBtn"
                Content="Close"
                Width="80"
                Height="36"
                HorizontalAlignment="Right"
                Click="cancelBtn_Click"/>
    </Grid>
</ContentDialog>
