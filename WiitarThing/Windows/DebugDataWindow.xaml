<Window x:Class="WiinUSoft.Windows.DebugDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WiinUSoft.Windows"
        mc:Ignorable="d"
        Title="Debug — Wiimote Data" Height="340" Width="560"
        MinWidth="440" MinHeight="280"
        Background="{DynamicResource BrushSocialBlue}"
        Icon="../Images/WiinUSoft_Icon32.png"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Wiimote data packets are displayed below."
                   FontSize="13"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1" Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,8">
            <RichTextBox x:Name="promptBoxContainer"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         FontSize="13"
                         FontFamily="Courier New"
                         IsReadOnly="True">
                <FlowDocument x:Name="prompt" PagePadding="2"/>
            </RichTextBox>
        </Border>

        <Button Grid.Row="2"
                x:Name="cancelBtn"
                Style="{StaticResource BaseButtonStyle}"
                Content="Close"
                Width="80" Height="28"
                HorizontalAlignment="Right"
                Click="cancelBtn_Click"/>
    </Grid>
</Window>
