<ContentDialog x:Class="WiinUSoft.PropWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Device Properties">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Device Properties"
                   FontSize="20"
                   Margin="0,0,0,20"/>

        <!-- Settings Panel -->
        <StackPanel Grid.Row="1"
                Spacing="16"
                Margin="0,0,0,20">
            <!-- Device Name -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Device Name"/>
                <TextBox x:Name="nameInput"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Text="{Binding Name, Mode=TwoWay}"
                         PlaceholderText="Enter device name"/>
            </Grid>

            <!-- Auto Connect -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Auto Connect"/>
                <ComboBox x:Name="autoConnectNumber"
                          Grid.Column="1"
                          Height="32"
                          SelectedIndex="{Binding AutoConnectIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Controller 1"/>
                    <ComboBoxItem Content="Controller 2"/>
                    <ComboBoxItem Content="Controller 3"/>
                    <ComboBoxItem Content="Controller 4"/>
                    <ComboBoxItem Content="First Available"/>
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Hidden controls for code-behind compatibility -->
        <CheckBox  x:Name="autoCheckbox"
                Visibility="Collapsed"
                IsChecked="{Binding AutoConnect, Mode=TwoWay}"/>
        <TextBox   x:Name="defaultInput"
                Visibility="Collapsed"
                Text="{Binding ProfilePath, Mode=TwoWay}"/>
        <Button    x:Name="defaultBtn"
                Visibility="Collapsed"
                Click="defaultBtn_Click"
                Content="..."/>
        <ComboBox  x:Name="rumbleSelection"
                Visibility="Collapsed"
                SelectedIndex="{Binding RumbleIndex, Mode=TwoWay}"/>
        <ComboBox  x:Name="calibrationSelection"
                Visibility="Collapsed"
                SelectedIndex="{Binding CalibrationIndex, Mode=TwoWay}"
                   SelectionChanged="Calibration_SelectionChanged"
                DropDownClosed="calibrationSelection_DropDownClosed">
            <ComboBoxItem Content="Default"/>
            <ComboBoxItem Content="Minimal"/>
            <ComboBoxItem Content="More"/>
            <ComboBoxItem Content="Extra"/>
            <ComboBoxItem Content="Custom"/>
        </ComboBox>
        <ComboBox  x:Name="pointerSelection"
                Visibility="Collapsed"
                SelectedIndex="{Binding PointerModeIndex, Mode=TwoWay}"/>

        <!-- Bottom action row -->
        <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
            <Button x:Name="cancelBtn"
                    Content="Cancel"
                    Width="80"
                    Height="36"
                    Click="cancelBtn_Click"/>
            <Button x:Name="saveBtn"
                    Content="Save"
                    Width="80"
                    Height="36"
                    Click="saveBtn_Click"/>
        </StackPanel>
    </Grid>
</ContentDialog>
