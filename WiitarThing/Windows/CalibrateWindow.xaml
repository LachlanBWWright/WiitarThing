<Window x:Class="WiinUSoft.CalibrateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WiinUSoft"
        Title="Calibration">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0"
                Spacing="4"
                Margin="0,0,0,12">
            <TextBlock x:Name="title"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="Calibrate Wiimote"/>
            <TextBlock x:Name="inst"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap">
                Rotate the Wiimote around to the left and right (roll) so the buttons face left and then right. Adjust the minimums and maximums of each axis as desired.
            </TextBlock>
        </StackPanel>

        <!-- Calibration groups -->
        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <!-- Joystick groups -->
                <StackPanel Orientation="Horizontal"
                        Spacing="8">
                    <!-- group1 -->
                    <Border x:Name="group1"
                            Width="190"
                            Height="190"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="group1Header"
                                    Grid.Row="0"
                                    Text="Left X-axis"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,8"/>
                            <Grid Grid.Row="1"
                                    RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Center:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="0"
                                        Grid.Column="1"
                                        x:Name="group1_center"
                                        Value="32"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1"
                                        Grid.Column="0"
                                        Text="Min:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="1"
                                        Grid.Column="1"
                                        x:Name="group1_min"
                                        Value="0"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Max:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="2"
                                        Grid.Column="1"
                                        x:Name="group1_max"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="3"
                                        Grid.Column="0"
                                        Text="Deadzone:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="3"
                                        Grid.Column="1"
                                        x:Name="group1_dead"
                                        Value="4"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- group2 -->
                    <Border x:Name="group2"
                            Width="190"
                            Height="190"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="group2Header"
                                    Grid.Row="0"
                                    Text="Left Y-axis"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,8"/>
                            <Grid Grid.Row="1"
                                    RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Center:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="0"
                                        Grid.Column="1"
                                        x:Name="group2_center"
                                        Value="32"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1"
                                        Grid.Column="0"
                                        Text="Min:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="1"
                                        Grid.Column="1"
                                        x:Name="group2_min"
                                        Value="0"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Max:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="2"
                                        Grid.Column="1"
                                        x:Name="group2_max"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="3"
                                        Grid.Column="0"
                                        Text="Deadzone:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="3"
                                        Grid.Column="1"
                                        x:Name="group2_dead"
                                        Value="4"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- group3 -->
                    <Border x:Name="group3"
                            Width="190"
                            Height="190"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="group3Header"
                                    Grid.Row="0"
                                    Text="Right X-axis"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,8"/>
                            <Grid Grid.Row="1"
                                    RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Center:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="0"
                                        Grid.Column="1"
                                        x:Name="group3_center"
                                        Value="32"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1"
                                        Grid.Column="0"
                                        Text="Min:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="1"
                                        Grid.Column="1"
                                        x:Name="group3_min"
                                        Value="0"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Max:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="2"
                                        Grid.Column="1"
                                        x:Name="group3_max"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="3"
                                        Grid.Column="0"
                                        Text="Deadzone:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="3"
                                        Grid.Column="1"
                                        x:Name="group3_dead"
                                        Value="4"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- group4 -->
                    <Border x:Name="group4"
                            Width="190"
                            Height="190"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="group4Header"
                                    Grid.Row="0"
                                    Text="Right Y-axis"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,8"/>
                            <Grid Grid.Row="1"
                                    RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Center:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="0"
                                        Grid.Column="1"
                                        x:Name="group4_center"
                                        Value="32"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1"
                                        Grid.Column="0"
                                        Text="Min:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="1"
                                        Grid.Column="1"
                                        x:Name="group4_min"
                                        Value="0"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Max:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="2"
                                        Grid.Column="1"
                                        x:Name="group4_max"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="3"
                                        Grid.Column="0"
                                        Text="Deadzone:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Row="3"
                                        Grid.Column="1"
                                        x:Name="group4_dead"
                                        Value="4"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- IR and Trigger groups -->
                <!-- group5: IR bounding box -->
                <Border x:Name="group5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="10"
                        Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                Text="IR Pointer Bounding Box (Dead Zone)"
                                FontWeight="SemiBold"
                                Margin="0,0,0,8"/>
                        <Grid Grid.Row="1"
                                ColumnSpacing="16"
                                RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                    Text="Center X:"
                                    VerticalAlignment="Center"
                                    FontSize="12"/>
                            <local:NumPicker Grid.Column="1"
                                    x:Name="group5_centerX"
                                    Max="1020"
                                    Min="2"
                                    Value="512"/>
                            <TextBlock Grid.Column="2"
                                    Text="Center Y:"
                                    VerticalAlignment="Center"
                                    FontSize="12"/>
                            <local:NumPicker Grid.Column="3"
                                    x:Name="group5_centerY"
                                    Max="1020"
                                    Min="2"
                                    Value="512"/>
                            <TextBlock Grid.Column="4"
                                    Text="Width:"
                                    VerticalAlignment="Center"
                                    FontSize="12"/>
                            <local:NumPicker Grid.Column="5"
                                    x:Name="group5_width"
                                    Min="0"
                                    Max="512"
                                    Value="128"/>
                            <TextBlock Grid.Column="6"
                                    Text="Height:"
                                    VerticalAlignment="Center"
                                    FontSize="12"/>
                            <local:NumPicker Grid.Column="7"
                                    x:Name="group5_height"
                                    Min="0"
                                    Max="512"
                                    Value="128"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Trigger groups -->
                <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,4,0,0">
                    <Border x:Name="groupL"
                            Visibility="Collapsed"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Padding="10"
                            HorizontalAlignment="Left">
                        <Grid MinWidth="280">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="groupLHeader"
                                    Grid.Row="0"
                                    Text="Left Trigger"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,8"/>
                            <Grid Grid.Row="1"
                                    ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                        Text="Min:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Column="1"
                                        x:Name="groupL_min"
                                        Max="32"/>
                                <TextBlock Grid.Column="2"
                                        Text="Max:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Column="3"
                                        x:Name="groupL_max"
                                        Max="64"
                                        Value="32"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="groupR"
                            Visibility="Collapsed"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Padding="10"
                            HorizontalAlignment="Left">
                        <Grid MinWidth="280">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="groupRHeader"
                                    Grid.Row="0"
                                    Text="Right Trigger"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,8"/>
                            <Grid Grid.Row="1"
                                    ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                        Text="Min:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Column="1"
                                        x:Name="groupR_min"
                                        Max="32"
                                        Value="0"/>
                                <TextBlock Grid.Column="2"
                                        Text="Max:"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                                <local:NumPicker Grid.Column="3"
                                        x:Name="groupR_max"
                                        Value="32"
                                        Max="64"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Action buttons row -->
        <Grid Grid.Row="2"
                Margin="0,12,0,0">
            <Button x:Name="skipBtn"
                    Content="Skip"
                    Width="80"
                    Height="36"
                    HorizontalAlignment="Left"
                    Click="skipBtn_Click"/>
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
                <Button x:Name="cancelBtn"
                        Content="Cancel"
                        Width="80"
                        Height="36"
                        Click="cancelBtn_Click"/>
                <Button x:Name="nextBtn"
                        Content="Next"
                        Width="100"
                        Height="36"
                        Click="nextBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
