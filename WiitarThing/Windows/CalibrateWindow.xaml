<Window x:Class="WiinUSoft.CalibrateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WiinUSoft"
        Title="Calibration">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="title" Grid.Row="0" Text="Wiimote" FontWeight="Bold" FontSize="14" Margin="2,2,2,0"/>

        <TextBlock x:Name="inst" Grid.Row="1" TextWrapping="Wrap" FontSize="13" Margin="2,2,2,8">
            Rotate the Wiimote around to the left and right (roll) so the buttons face to the left and then to the right. Adjust the minimums and maximums of each axis as desired.
        </TextBlock>

        <!-- Calibration groups -->
        <Canvas Grid.Row="2" Height="200">
            <!-- group1 -->
            <Border x:Name="group1" Canvas.Left="0" Canvas.Top="0" Width="190" Height="190"
                    BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="group1Header" Grid.Row="0" Text="Left X-axis" FontWeight="SemiBold" Margin="6,2" FontSize="11"/>
                    <Grid Grid.Row="1">
                        <TextBlock Text="Center:"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group1_center" HorizontalAlignment="Left" Margin="83,10,0,0" VerticalAlignment="Top" Value="32"/>
                        <TextBlock Text="Minimum:" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group1_min"    HorizontalAlignment="Left" Margin="83,50,0,0" VerticalAlignment="Top" Value="0"/>
                        <TextBlock Text="Maximum:" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group1_max"    HorizontalAlignment="Left" Margin="83,90,0,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Deadzone:" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group1_dead"   HorizontalAlignment="Left" Margin="83,130,0,0" VerticalAlignment="Top" Value="4"/>
                    </Grid>
                </Grid>
            </Border>
            <!-- group2 -->
            <Border x:Name="group2" Canvas.Left="195" Canvas.Top="0" Width="190" Height="190"
                    BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="group2Header" Grid.Row="0" Text="Left Y-axis" FontWeight="SemiBold" Margin="6,2" FontSize="11"/>
                    <Grid Grid.Row="1">
                        <TextBlock Text="Center:"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group2_center" HorizontalAlignment="Left" Margin="83,10,0,0" VerticalAlignment="Top" Value="32"/>
                        <TextBlock Text="Minimum:" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group2_min"    HorizontalAlignment="Left" Margin="83,50,0,0" VerticalAlignment="Top" Value="0"/>
                        <TextBlock Text="Maximum:" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group2_max"    HorizontalAlignment="Left" Margin="83,90,0,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Deadzone:" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group2_dead"   HorizontalAlignment="Left" Margin="83,130,0,0" VerticalAlignment="Top" Value="4"/>
                    </Grid>
                </Grid>
            </Border>
            <!-- group3 -->
            <Border x:Name="group3" Canvas.Left="390" Canvas.Top="0" Width="190" Height="190"
                    BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="group3Header" Grid.Row="0" Text="Right X-axis" FontWeight="SemiBold" Margin="6,2" FontSize="11"/>
                    <Grid Grid.Row="1">
                        <TextBlock Text="Center:"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group3_center" HorizontalAlignment="Left" Margin="83,10,0,0" VerticalAlignment="Top" Value="32"/>
                        <TextBlock Text="Minimum:" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group3_min"    HorizontalAlignment="Left" Margin="83,50,0,0" VerticalAlignment="Top" Value="0"/>
                        <TextBlock Text="Maximum:" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group3_max"    HorizontalAlignment="Left" Margin="83,90,0,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Deadzone:" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group3_dead"   HorizontalAlignment="Left" Margin="83,130,0,0" VerticalAlignment="Top" Value="4"/>
                    </Grid>
                </Grid>
            </Border>
            <!-- group4 -->
            <Border x:Name="group4" Canvas.Left="585" Canvas.Top="0" Width="190" Height="190"
                    BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="group4Header" Grid.Row="0" Text="Right Y-axis" FontWeight="SemiBold" Margin="6,2" FontSize="11"/>
                    <Grid Grid.Row="1">
                        <TextBlock Text="Center:"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group4_center" HorizontalAlignment="Left" Margin="83,10,0,0" VerticalAlignment="Top" Value="32"/>
                        <TextBlock Text="Minimum:" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group4_min"    HorizontalAlignment="Left" Margin="83,50,0,0" VerticalAlignment="Top" Value="0"/>
                        <TextBlock Text="Maximum:" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group4_max"    HorizontalAlignment="Left" Margin="83,90,0,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Deadzone:" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group4_dead"   HorizontalAlignment="Left" Margin="83,130,0,0" VerticalAlignment="Top" Value="4"/>
                    </Grid>
                </Grid>
            </Border>
        </Canvas>

        <!-- IR / trigger groups + action buttons -->
        <StackPanel Grid.Row="3" Margin="0,4,0,0">
            <!-- group5: IR bounding box -->
            <Border x:Name="group5" Width="775" Height="69" HorizontalAlignment="Left"
                    BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="IR Pointer Bounding Box (Dead Zone)" FontWeight="SemiBold" Margin="6,2" FontSize="11"/>
                    <Grid Grid.Row="1">
                        <TextBlock Text="Center X:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group5_centerX" HorizontalAlignment="Left" Margin="82,10,0,0" VerticalAlignment="Top" Max="1020" Min="2" Value="512"/>
                        <TextBlock Text="Center Y:" HorizontalAlignment="Left" Margin="205,10,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group5_centerY" HorizontalAlignment="Left" Margin="278,10,0,0" VerticalAlignment="Top" Max="1020" Min="2" Value="512"/>
                        <TextBlock Text="Width:"    HorizontalAlignment="Left" Margin="400,10,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group5_width"   HorizontalAlignment="Left" Margin="473,10,0,0" VerticalAlignment="Top" Min="0" Max="512" Value="128"/>
                        <TextBlock Text="Height:"   HorizontalAlignment="Left" Margin="595,10,0,0" VerticalAlignment="Top"/>
                        <local:NumPicker x:Name="group5_height"  HorizontalAlignment="Left" Margin="668,10,0,0" VerticalAlignment="Top" Min="0" Max="512" Value="128"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- groupL + groupR triggers -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border x:Name="groupL" Visibility="Collapsed" Width="385" Height="69"
                        BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1" CornerRadius="4" Margin="0,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="groupLHeader" Grid.Row="0" Text="Left Trigger" FontWeight="SemiBold" Margin="6,2" FontSize="11"/>
                        <Grid Grid.Row="1">
                            <TextBlock Text="Minimum:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                            <local:NumPicker x:Name="groupL_min" HorizontalAlignment="Left" Margin="83,10,0,0" VerticalAlignment="Top" Max="32"/>
                            <TextBlock Text="Maximum:" HorizontalAlignment="Left" Margin="205,10,0,0" VerticalAlignment="Top"/>
                            <local:NumPicker x:Name="groupL_max" HorizontalAlignment="Left" Margin="278,10,0,0" VerticalAlignment="Top" Max="64" Value="32"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="groupR" Visibility="Collapsed" Width="385" Height="69"
                        BorderBrush="{StaticResource Brush.BorderAccent}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="groupRHeader" Grid.Row="0" Text="Right Trigger" FontWeight="SemiBold" Margin="6,2" FontSize="11"/>
                        <Grid Grid.Row="1">
                            <TextBlock Text="Minimum:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                            <local:NumPicker x:Name="groupR_min" HorizontalAlignment="Left" Margin="83,10,0,0" VerticalAlignment="Top" Max="32" Value="0"/>
                            <TextBlock Text="Maximum:" HorizontalAlignment="Left" Margin="205,10,0,0" VerticalAlignment="Top"/>
                            <local:NumPicker x:Name="groupR_max" HorizontalAlignment="Left" Margin="278,10,0,0" VerticalAlignment="Top" Value="32" Max="64"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Action buttons row -->
            <Grid Margin="0,8,0,0">
                <Button x:Name="skipBtn"   Style="{StaticResource BaseButtonStyle}"    Content="Skip"   Width="72"  Height="28" HorizontalAlignment="Left"  Click="skipBtn_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="cancelBtn" Style="{StaticResource BaseButtonStyle}"    Content="Cancel" Width="72"  Height="28" Margin="0,0,8,0" Click="cancelBtn_Click"/>
                    <Button x:Name="nextBtn"   Style="{StaticResource PrimaryButtonStyle}" Content="Next"   Width="104" Height="28" Click="nextBtn_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
