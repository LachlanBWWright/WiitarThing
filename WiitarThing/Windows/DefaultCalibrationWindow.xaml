<Window x:Class="WiinUSoft.Windows.DefaultCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Default Calibration">
        <Grid Margin="20">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="4"
                                Margin="0,0,0,12">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}"
                                        Text="Default Calibration"/>
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Choose a calibration setting to use by default, or copy preferences from an existing device profile."
                                   TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                                Spacing="12">
                        <RadioButton x:Name="radioMin"
                                     Content="Minimum"
                                     GroupName="selection"
                                     FontSize="14"/>
                        <RadioButton x:Name="radioDefault"
                                     Content="Default (Recommended)"
                                     GroupName="selection"
                                     FontSize="14"
                                     IsChecked="True"/>
                        <RadioButton x:Name="radioMod"
                                     Content="Moderate"
                                     GroupName="selection"
                                     FontSize="14"/>
                        <RadioButton x:Name="radioExt"
                                     Content="Extra"
                                     GroupName="selection"
                                     FontSize="14"/>
                        <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        Margin="20,8,0,0">
                                <RadioButton x:Name="radioCopy"
                                             Content="Copy From:"
                                             GroupName="selection"
                                             FontSize="14"
                                             IsEnabled="False"
                                             VerticalAlignment="Center"/>
                                <ComboBox x:Name="copyCombo"
                                          IsEnabled="False"
                                          MinWidth="180"
                                          Height="32"/>
                        </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0"
                            Spacing="8">
                        <Button x:Name="clearBtn"
                                Content="Clear"
                                Width="90"
                                Height="36"
                                Click="clearBtn_Click"/>
                        <Button x:Name="saveBtn"
                                Content="Save"
                                Width="90"
                                Height="36"
                                Click="saveBtn_Click"/>
                </StackPanel>
        </Grid>
</Window>
