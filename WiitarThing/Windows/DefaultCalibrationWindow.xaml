<ContentDialog x:Class="WiinUSoft.Windows.DefaultCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Default Calibration"
        PrimaryButtonText="Save"
        SecondaryButtonText="Clear"
        CloseButtonText="Cancel"
        Opened="ContentDialog_Opened"
        PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
        SecondaryButtonClick="ContentDialog_SecondaryButtonClick">
        <Grid MaxWidth="420"
              HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="4"
                                Margin="0,0,0,12">
                        <TextBlock Text="Default Calibration"/>
                        <TextBlock
                                   Text="Choose a calibration setting to use by default, or copy preferences from an existing device profile."
                                   TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                                Spacing="12">
                        <RadioButton x:Name="radioMin"
                                     Content="Minimum"
                                     GroupName="selection"
                                     IsChecked="{Binding Minimum, Mode=TwoWay}"
                                     FontSize="14"/>
                        <RadioButton x:Name="radioDefault"
                                     Content="Default (Recommended)"
                                     GroupName="selection"
                                     FontSize="14"
                                     IsChecked="{Binding Default, Mode=TwoWay}"/>
                        <RadioButton x:Name="radioMod"
                                     Content="Moderate"
                                     GroupName="selection"
                                     IsChecked="{Binding Moderate, Mode=TwoWay}"
                                     FontSize="14"/>
                        <RadioButton x:Name="radioExt"
                                     Content="Extra"
                                     GroupName="selection"
                                     IsChecked="{Binding Extra, Mode=TwoWay}"
                                     FontSize="14"/>
                        <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        Margin="20,8,0,0">
                                <RadioButton x:Name="radioCopy"
                                             Content="Copy From:"
                                             GroupName="selection"
                                             IsChecked="{Binding Copy, Mode=TwoWay}"
                                             FontSize="14"
                                             IsEnabled="{Binding CanCopy}"
                                             VerticalAlignment="Center"/>
                                <ComboBox x:Name="copyCombo"
                                          ItemsSource="{Binding CopyOptions}"
                                          SelectedIndex="{Binding CopyIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding CanCopy}"
                                          MinWidth="180"
                                          Height="32"/>
                        </StackPanel>
                </StackPanel>
        </Grid>
</ContentDialog>
