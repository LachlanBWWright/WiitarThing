<Window x:Class="WiinUSoft.Windows.DesignGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiitarThing UI Gallery">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="GalleryRoot" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,138,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="20" Height="20" Source="Images/GHWT_Wii_Guitar.png" />
                <TextBlock Text="WiitarThing UI Gallery" FontWeight="SemiBold" />
                <TextBlock Text="Debug only" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="16,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="stateSelector" Width="180" Header="Gallery state"
                      SelectionChanged="StateSelector_SelectionChanged">
                <ComboBoxItem Content="Empty" />
                <ComboBoxItem Content="Detected devices" />
                <ComboBoxItem Content="Connected controllers" />
                <ComboBoxItem Content="Driver warning" />
                <ComboBoxItem Content="Sync in progress" />
                <ComboBoxItem Content="Disconnected controller" />
            </ComboBox>
            <Button Grid.Column="1" Content="Capture current" VerticalAlignment="Bottom"
                    Click="CaptureCurrent_Click" />
            <Button Grid.Column="2" Content="Capture all" VerticalAlignment="Bottom"
                    Click="CaptureAll_Click" />
            <TextBlock x:Name="captureStatus" Grid.Column="3" Margin="12,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="PNG output: artifacts/ui-gallery" />
        </Grid>

        <Border x:Name="GallerySurface" Grid.Row="2" Margin="16,8,16,16" Padding="24"
                Height="420" MaxWidth="1200" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid x:Name="StateCanvas" MaxWidth="1100" HorizontalAlignment="Stretch">
                <Grid x:Name="EmptyState">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <SymbolIcon Symbol="Play" Width="48" Height="48" HorizontalAlignment="Center" />
                        <TextBlock Text="No controllers detected" Style="{ThemeResource TitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Press SYNC on a Wiimote or use Refresh to find a device."
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="DetectedState" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Detected Devices" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Production device controls with isolated gallery sessions" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <StackPanel x:Name="DetectedRows" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ConnectedState" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Active Controllers" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel x:Name="ConnectedRows" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="WarningState" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Connection Failure" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel x:Name="WarningRows" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="DisconnectedState" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Disconnected Controller" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel x:Name="DisconnectedRows" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="SyncState" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                        <TextBlock Text="Listening for controllers" Style="{ThemeResource TitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Press the red SYNC button on your Wiimote."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
