<Window x:Class="WiinUSoft.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Error" Height="420" Width="460"
        Background="{DynamicResource BrushSocialBlue}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="The application has encountered an unhandled error."
                   FontWeight="SemiBold" FontSize="13"
                   Foreground="{DynamicResource Brush.Danger}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <Label x:Name="_errorMessage"
               Grid.Row="1"
               Content="Error Message:"
               FontWeight="SemiBold" FontSize="13"
               Padding="0"
               Margin="0,0,0,6"/>

        <Border Grid.Row="2" Style="{StaticResource SectionPanelStyle}" Margin="0,0,0,8">
            <TextBox x:Name="_errorStack"
                     Text="More Info"
                     Background="Transparent"
                     BorderThickness="0"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     FontStyle="Italic"
                     FontSize="12"
                     FontFamily="Courier New"/>
        </Border>

        <Button Grid.Row="3"
                x:Name="_dontSendBtn"
                Style="{StaticResource BaseButtonStyle}"
                Content="Close"
                Width="80" Height="28"
                HorizontalAlignment="Right"
                Click="_dontSendBtn_Click"/>
    </Grid>
</Window>
