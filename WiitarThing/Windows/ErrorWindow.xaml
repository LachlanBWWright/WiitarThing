<ContentDialog x:Class="WiinUSoft.ErrorWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Application Error">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Error Title -->
        <StackPanel Grid.Row="0"
                Spacing="6"
                Margin="0,0,0,12">
            <TextBlock
                       Text="Application Error"/>
            <TextBlock
                       Text="An unhandled error has occurred. Here is the error information:"/>
        </StackPanel>

        <!-- Error Message -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="12">
            <TextBlock x:Name="_errorMessage"
                       Text="Error Message:"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Error Details -->
        <Border Grid.Row="2"
                Margin="0,0,0,12"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="12">
            <TextBox x:Name="_errorStack"
                     Text="Stack Trace"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     FontSize="11"/>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="3"
                x:Name="_dontSendBtn"
                Content="Close"
                Width="80"
                Height="36"
                HorizontalAlignment="Right"
                Click="_dontSendBtn_Click"/>
    </Grid>
</ContentDialog>
