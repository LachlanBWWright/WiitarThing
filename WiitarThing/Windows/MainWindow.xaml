<Window
        x:Class="WiinUSoft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiitarThing">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="AppTitleBar"
                      Grid.Row="0"
                      Padding="0,0,138,0">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="20"
                               Height="20"
                               Margin="16,0,12,0"
                               VerticalAlignment="Center"
                               Source="Images/GHWT_Wii_Guitar.png"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="AppTitleText"
                                           Text="{x:Bind ViewModel.AppTitleText, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="labelDebugBuild"
                                            Text="Debug"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind ViewModel.DebugBuildVisibility, Mode=OneWay}"
                                            VerticalAlignment="Center"/>
                        </StackPanel>
                </Grid>

        <MenuBar Grid.Row="1"
                         Padding="8,4"
                         >
            <MenuBarItem Title="Device">
                                <MenuFlyoutItem Text="Remove All Wiimotes"
                                                Command="{x:Bind ViewModel.RemoveAllWiimotesCommand}"/>
                        </MenuBarItem>
                        <MenuBarItem Title="Tools">
                                <MenuFlyoutItem Text="Test Controllers"
                                                Command="{x:Bind ViewModel.TestControllersCommand}"/>
                                <MenuFlyoutItem Text="Default Calibration"
                                                Command="{x:Bind ViewModel.SetDefaultCalibrationCommand}"/>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="UiGalleryMenuItem"
                                                Text="UI Gallery (Debug)"
                                                Click="UiGalleryMenuItem_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="Settings">
                                <MenuFlyoutItem Text="{x:Bind ViewModel.VersionText, Mode=OneWay}"
                                                IsEnabled="False"/>
                                <MenuFlyoutItem Text="Built upon WiinUSoft by Justin Keys. Guitar support by Meowmaritus."
                                                IsEnabled="False"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem
                                                       Text="Start with Windows"
                                                       IsChecked="{x:Bind ViewModel.AutoStartEnabled, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem
                                                       Text="Start minimized"
                                                       IsChecked="{x:Bind ViewModel.StartMinimizedEnabled, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem
                                                       Text="Exclusive Bluetooth access"
                                                       IsChecked="{x:Bind ViewModel.ExclusiveBluetoothAccessEnabled, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem
                                                       Text="Auto refresh"
                                                       IsChecked="{x:Bind ViewModel.AutoRefreshEnabled, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem
                                                       Text="Use Microsoft Bluetooth stack"
                                                       IsChecked="{x:Bind ViewModel.UseMicrosoftBluetoothStack, Mode=TwoWay}"/>
                        </MenuBarItem>
                </MenuBar>

                <!-- Main Content -->
                <Grid Grid.Row="2"
                                Margin="12">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Detected Devices"
                                                   Style="{ThemeResource SubheaderTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="12,0,0,0">
                                                <Button x:Name="menuSync"
                                                        Height="32"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        ToolTipService.ToolTip="Sync a new controller"
                                                        IsEnabled="{x:Bind ViewModel.IsSyncEnabled, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.SyncCommand}">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    VerticalAlignment="Center">
                                                                <SymbolIcon Symbol="Sync"
                                                                            VerticalAlignment="Center"/>
                                                                <TextBlock Text="Sync New"/>
                                                        </StackPanel>
                                                </Button>
                                                <Button Height="32"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        ToolTipService.ToolTip="Refresh detected devices"
                                                        Command="{x:Bind ViewModel.RefreshCommand}">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    VerticalAlignment="Center">
                                                                <SymbolIcon Symbol="Refresh"
                                                                            VerticalAlignment="Center"/>
                                                                <TextBlock Text="Refresh"/>
                                                        </StackPanel>
                                                </Button>
                                        </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1"
                                      Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Press SYNC on your Wiimote or use the Refresh button to find new devices."
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                                <ProgressRing x:Name="AutoRefreshRing"
                                                              Width="16"
                                                              Height="16"
                                                              IsActive="{x:Bind ViewModel.IsAutoRefreshRingActive, Mode=OneWay}"
                                                              Visibility="{x:Bind ViewModel.AutoRefreshRingVisibility, Mode=OneWay}"/>
                                                <TextBlock x:Name="AutoRefreshStatus"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Text="{x:Bind ViewModel.AutoRefreshStatusText, Mode=OneWay}"
                                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                </Grid>
                                <Border Grid.Row="2"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        BorderThickness="1"
                                        Padding="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableDevices, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                        <ContentPresenter Content="{Binding View}"/>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                         </ScrollViewer>
                                 </Border>
                         </Grid>

                        <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Active Controllers"
                                                   Style="{ThemeResource SubheaderTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                         <Button Grid.Column="1"
                                                 x:Name="btnDetatchAllXInput"
                                                 Height="32"
                                                 Style="{StaticResource AccentButtonStyle}"
                                                 ToolTipService.ToolTip="Disconnect all connected controllers"
                                                 Command="{x:Bind ViewModel.DisconnectAllCommand}"
                                                 Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                        <SymbolIcon Symbol="DisconnectDrive"/>
                                                        <TextBlock Text="Disconnect All"/>
                                                </StackPanel>
                                        </Button>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="Connected devices will appear here. Use Test Controllers to manage mappings."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <Border Grid.Row="2"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        BorderThickness="1"
                                        Padding="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.ConnectedDevices, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                        <ContentPresenter Content="{Binding View}"/>
                                                                </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                         </ScrollViewer>
                                 </Border>
                         </Grid>
                </Grid>
        </Grid>
</Window>
