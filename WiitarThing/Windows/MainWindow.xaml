<Window
        x:Class="WiinUSoft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiitarThing">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="AppTitleBar"
                      Grid.Row="0"
                      Padding="0,0,138,0">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="20"
                               Height="20"
                               Margin="16,0,12,0"
                               VerticalAlignment="Center"
                               Source="Images/GHWT_Wii_Guitar.png"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="AppTitleText"
                                           Text="WiitarThing"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="labelDebugBuild"
                                           Text="Debug"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                        </StackPanel>
                </Grid>

        <MenuBar Grid.Row="1"
                         Padding="8,4"
                         >
            <MenuBarItem Title="Device">
                                <MenuFlyoutItem x:Name="menuSync"
                                                Text="Sync New Controller"
                                                Click="btnSync_Click"/>
                                <MenuFlyoutItem Text="Refresh"
                                                Click="btnRefresh_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Remove All Wiimotes"
                                                Click="btnRemoveAllWiimotes_Click"/>
                                <MenuFlyoutItem Text="Disconnect All Controllers"
                                                Click="btnDetatchAllXInput_Click"/>
                        </MenuBarItem>
                        <MenuBarItem Title="Tools">
                                <MenuFlyoutItem Text="Test Controllers"
                                                Click="buttonTestInputs_Click"/>
                                <MenuFlyoutItem Text="Default Calibration"
                                                Click="menu_SetDefaultCalibration_Click"/>
                        </MenuBarItem>
                        <MenuBarItem Title="Settings">
                                <MenuFlyoutItem x:Name="menu_version"
                                                Text="Version"
                                                IsEnabled="False"/>
                                <MenuFlyoutItem Text="Built upon WiinUSoft by Justin Keys. Guitar support by Meowmaritus."
                                                IsEnabled="False"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem x:Name="menu_AutoStart"
                                                       Text="Start with Windows"
                                                       Click="menu_AutoStart_Click"/>
                                <ToggleMenuFlyoutItem x:Name="menu_StartMinimized"
                                                       Text="Start minimized"
                                                       Click="menu_StartMinimized_Click"/>
                                <ToggleMenuFlyoutItem x:Name="menu_NoSharing"
                                                       Text="Exclusive Bluetooth access"
                                                       Click="menu_NoSharing_Click"/>
                                <ToggleMenuFlyoutItem x:Name="menu_AutoRefresh"
                                                       Text="Auto refresh"
                                                       Click="menu_AutoRefresh_Click"/>
                                <ToggleMenuFlyoutItem x:Name="menu_MsBluetooth"
                                                       Text="Use Microsoft Bluetooth stack"
                                                       Click="menu_MsBluetooth_Click"/>
                        </MenuBarItem>
                </MenuBar>

                <!-- Main Content -->
                <Grid Grid.Row="2"
                                Margin="12">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Detected Devices"
                                           Style="{ThemeResource SubheaderTextBlockStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1"
                                           Text="Press SYNC on your Wiimote or use the Refresh button to find new devices."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <Border Grid.Row="2"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Padding="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="groupAvailable"
                                                            Spacing="2"/>
                                        </ScrollViewer>
                                </Border>
                        </Grid>

                        <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Active Controllers"
                                                   Style="{ThemeResource SubheaderTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                x:Name="btnDetatchAllXInput"
                                                Height="32"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Disconnect all connected controllers"
                                                Click="btnDetatchAllXInput_Click"
                                                Margin="12,0,0,0">Disconnect All</Button>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="Connected devices will appear here. Use Test Controllers to manage mappings."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <Border Grid.Row="2"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Padding="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="groupXinput"
                                                            Spacing="2"/>
                                        </ScrollViewer>
                                </Border>
                        </Grid>
                </Grid>
        </Grid>
</Window>
