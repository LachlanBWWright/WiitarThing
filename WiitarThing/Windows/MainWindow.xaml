<Window
        x:Class="WiinUSoft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiitarThing">

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <MenuBar Grid.Row="0"
                         Padding="8,4"
                         Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <MenuBarItem Title="Device">
                                <MenuFlyoutItem x:Name="menuSync"
                                                Text="Sync New Controller"
                                                Click="btnSync_Click"/>
                                <MenuFlyoutItem Text="Refresh"
                                                Click="btnRefresh_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Remove All Wiimotes"
                                                Click="btnRemoveAllWiimotes_Click"/>
                                <MenuFlyoutItem Text="Disconnect All Controllers"
                                                Click="btnDetatchAllXInput_Click"/>
                        </MenuBarItem>
                        <MenuBarItem Title="Tools">
                                <MenuFlyoutItem Text="Test Controllers"
                                                Click="buttonTestInputs_Click"/>
                                <MenuFlyoutItem Text="Default Calibration"
                                                Click="menu_SetDefaultCalibration_Click"/>
                        </MenuBarItem>
                        <MenuBarItem Title="Settings">
                                <MenuFlyoutItem x:Name="menu_version"
                                                Text="Version"
                                                IsEnabled="False"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem x:Name="menu_AutoStart"
                                                       Text="Start with Windows"
                                                       Click="menu_AutoStart_Click"/>
                                <ToggleMenuFlyoutItem x:Name="menu_StartMinimized"
                                                       Text="Start minimized"
                                                       Click="menu_StartMinimized_Click"/>
                                <ToggleMenuFlyoutItem x:Name="menu_NoSharing"
                                                       Text="Exclusive Bluetooth access"
                                                       Click="menu_NoSharing_Click"/>
                                <ToggleMenuFlyoutItem x:Name="menu_AutoRefresh"
                                                       Text="Auto refresh"
                                                       Click="menu_AutoRefresh_Click"/>
                                <ToggleMenuFlyoutItem x:Name="menu_MsBluetooth"
                                                       Text="Use Microsoft Bluetooth stack"
                                                       Click="menu_MsBluetooth_Click"/>
                        </MenuBarItem>
                </MenuBar>

                <!-- Main Content -->
                <Grid Grid.Row="1"
                                Margin="12">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Detected Devices"
                                           Style="{ThemeResource SubheaderTextBlockStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1"
                                           Text="Press SYNC on your Wiimote or use the Refresh button to find new devices."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="groupAvailable"
                                                    Spacing="8"/>
                                </ScrollViewer>
                        </Grid>

                        <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Active Controllers"
                                           Style="{ThemeResource SubheaderTextBlockStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1"
                                           Text="Connected devices will appear here. Use Test Controllers to manage mappings."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="groupXinput"
                                                    Spacing="8"/>
                                </ScrollViewer>
                                <Button Grid.Row="3"
                                        x:Name="btnDetatchAllXInput"
                                        Height="32"
                                        ToolTipService.ToolTip="Disconnect all connected controllers"
                                        Click="btnDetatchAllXInput_Click"
                                        Margin="0,12,0,0">Disconnect All</Button>
                        </Grid>
                </Grid>

                <!-- Footer -->
                <TextBlock Grid.Row="2"
                           Text="Built upon WiinUSoft by Justin Keys. Guitar support by Meowmaritus."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="12,12,12,12"/>
        </Grid>
</Window>
