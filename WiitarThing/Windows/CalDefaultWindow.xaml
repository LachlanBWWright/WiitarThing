<Window x:Class="WiinUSoft.Windows.CalDefaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WiinUSoft.Windows"
        mc:Ignorable="d"
        Title="Default Calibration" Height="290" Width="320"
        Background="{DynamicResource BrushSocialBlue}"
        Icon="../Images/WiinUSoft_Icon32.png"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Margin="0,0,0,12">
            Choose a calibration setting to set as the default, or select a device to copy calibration and auto-connect preferences from.
        </TextBlock>

        <StackPanel Grid.Row="1" Margin="4,0,0,0">
            <RadioButton x:Name="radioMin"     Content="Minimum"    GroupName="selection" FontSize="13" Margin="0,0,0,6"/>
            <RadioButton x:Name="radioDefault" Content="Default"    GroupName="selection" FontSize="13" Margin="0,0,0,6" IsChecked="True"/>
            <RadioButton x:Name="radioMod"     Content="Moderate"   GroupName="selection" FontSize="13" Margin="0,0,0,6"/>
            <RadioButton x:Name="radioExt"     Content="Extra"      GroupName="selection" FontSize="13" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="radioCopy" Content="Copy From:" GroupName="selection" FontSize="13"
                             IsEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="copyCombo" IsEnabled="False" MinWidth="120" Height="26"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="clearBtn"
                    Style="{StaticResource BaseButtonStyle}"
                    Content="Clear"
                    Width="72" Height="28"
                    Margin="0,0,8,0"
                    Click="clearBtn_Click"/>
            <Button x:Name="saveBtn"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Save"
                    Width="72" Height="28"
                    Click="saveBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
