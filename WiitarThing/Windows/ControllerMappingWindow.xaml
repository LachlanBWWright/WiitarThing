<Window x:Class="WiinUSoft.ControllerMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller Mapping">
    <Grid Margin="16"
            RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="headerText"
                   Text="Edit mappings for the selected controller. Keys on the left map to Xbox targets on the right."
                   TextWrapping="Wrap"/>

        <Border Grid.Row="1"
                Padding="8"
                BorderBrush="{StaticResource BrushAntemBlue}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="rowsHost"
                        Spacing="8"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
            <Button x:Name="btnDefault"
                    Content="Default"
                    Width="100"
                    Click="btnDefault_Click"/>
            <Button x:Name="btnApply"
                    Content="Apply"
                    Width="100"
                    Click="btnApply_Click"/>
            <Button x:Name="btnSave"
                    Content="Save"
                    Width="100"
                    Click="btnSave_Click"/>
            <Button x:Name="btnCancel"
                    Content="Cancel"
                    Width="100"
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
