<ContentDialog x:Class="WiinUSoft.ControllerMappingWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Controller Mapping">
        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="6"
                                Margin="0,0,0,12">
                        <TextBlock Text="Controller Mapping"
                                   FontSize="20"/>
                        <TextBlock x:Name="headerText"
                                   Text="Edit mappings for the selected controller. Keys on the left map to Xbox targets on the right."
                                   TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,0,0,12"
                              VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="rowsHost"
                                    Spacing="8"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                        <Button x:Name="btnDefault"
                                Content="Default"
                                Width="100"
                                Height="36"
                                Click="btnDefault_Click"/>
                        <Button x:Name="btnApply"
                                Content="Apply"
                                Width="100"
                                Height="36"
                                Click="btnApply_Click"/>
                        <Button x:Name="btnSave"
                                Content="Save"
                                Width="100"
                                Height="36"
                                Click="btnSave_Click"/>
                        <Button x:Name="btnCancel"
                                Content="Cancel"
                                Width="100"
                                Height="36"
                                Click="btnCancel_Click"/>
                </StackPanel>
        </Grid>
</ContentDialog>
